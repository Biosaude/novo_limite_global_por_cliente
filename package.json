{
  "name": "biosaude-limite-global",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && npm run check:client && npm run check:server",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.server.json --noEmit",
    "db:check": "node --env-file-if-exists=.env --import tsx scripts/check-database.ts",
    "db:plan": "tsx scripts/migration-plan.ts",
    "check:client": "tsx scripts/check-client-bundle.ts",
    "test:connectivity": "tsx --test tests/neon-connectivity.test.ts",
    "db:probe:preview": "node --env-file-if-exists=.env.neon-diagnostic --import tsx scripts/check-neon-preview.ts",
    "db:diagnostic-key": "tsx scripts/diagnostic-key.ts",
    "test:financial-api": "tsx --test tests/financial-api.test.ts",
    "test:remote:e2e": "VITE_FINANCIAL_REMOTE_ENABLED=true VITE_ALLOW_LOCAL_FALLBACK=true npm run build && REMOTE_E2E=true playwright test tests/remote-integration.spec.ts --project=desktop",
    "check:server": "tsx --test tests/server-runtime.test.ts"
  },
  "dependencies": {
    "@neondatabase/auth": "0.7.0-beta",
    "@neondatabase/serverless": "^1.2.0",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "jose": "^6.2.14",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
