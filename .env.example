# Somente no servidor. Copie localmente para .env e configure pelo canal seguro do provedor.
# Deixe vazio até configurar a URL PostgreSQL do Neon, com sslmode=require (ou verificação mais estrita).
# Não há conexão automática, ativação de persistência remota ou migração ao definir esta variável.
# Nunca crie uma variável VITE_ para a conexão e nunca versione credenciais reais.
DATABASE_URL=

# Etapa 2: chave temporária de 32 bytes aleatórios (64 caracteres hexadecimais).
# Configure somente em Preview/Development e no cliente operador, nunca como VITE_.
# Ausente/inválida = diagnóstico desabilitado; Production é sempre bloqueada.
NEON_DIAGNOSTIC_TOKEN=

# Etapa 3: desabilitado por padrão. Somente Preview/Development; Production sempre bloqueada.
FINANCIAL_API_ENABLED=false
# Provedor externo confiável: emissor exato, audience exclusiva da API e endpoint HTTPS JWKS.
# Sem provedor configurado e vínculo provisionado no banco, nenhum acesso financeiro é autorizado.
FINANCIAL_AUTH_ISSUER=
FINANCIAL_AUTH_AUDIENCE=
FINANCIAL_AUTH_JWKS_URL=

# Integração operacional: URL pública do serviço Auth da branch desenvolvimento, somente no servidor.
# HTTPS; termina normalmente em /neondb/auth. Não é DATABASE_URL.
NEON_AUTH_BASE_URL=
# Origem exata do Preview (sem caminho/barra final); VERCEL_URL/VERCEL_BRANCH_URL também são reconhecidas.
AUTH_APP_ORIGIN=
# Flags públicas de interface: false mantém o comportamento IndexedDB anterior.
# Configurar somente no Preview/Development durante a homologação.
VITE_FINANCIAL_REMOTE_ENABLED=false
VITE_ALLOW_LOCAL_FALLBACK=false
# UUID público opcional da organização. Nunca concede acesso por si só.
VITE_FINANCIAL_WORKSPACE_ID=
