# Somente no servidor. Copie localmente para .env e configure pelo canal seguro do provedor.
# Deixe vazio até configurar a URL PostgreSQL do Neon, com sslmode=require (ou verificação mais estrita).
# Não há conexão automática, ativação de persistência remota ou migração ao definir esta variável.
# Nunca crie uma variável VITE_ para a conexão e nunca versione credenciais reais.
DATABASE_URL=

# Production: Auth e APIs financeiras têm liberações independentes; manter false até aprovação.
# Preview/Development preservam o proxy Auth existente sem exigir essa flag.
AUTH_PRODUCTION_ENABLED=false
FINANCIAL_PRODUCTION_ENABLED=false

# Etapa 2: chave temporária de 32 bytes aleatórios (64 caracteres hexadecimais).
# Configure somente em Preview/Development e no cliente operador, nunca como VITE_.
# Ausente/inválida = diagnóstico desabilitado; Production é sempre bloqueada.
NEON_DIAGNOSTIC_TOKEN=

# APIs financeiras: Production exige também FINANCIAL_PRODUCTION_ENABLED=true.
FINANCIAL_API_ENABLED=false
# Provedor externo confiável: emissor exato, audience exclusiva da API e endpoint HTTPS JWKS.
# Sem provedor configurado e vínculo provisionado no banco, nenhum acesso financeiro é autorizado.
FINANCIAL_AUTH_ISSUER=
FINANCIAL_AUTH_AUDIENCE=
FINANCIAL_AUTH_JWKS_URL=

# URL do serviço Auth escolhido para ESTE ambiente, somente no servidor.
# Configurar cada escopo separadamente, sem reutilizar o desenvolvimento por suposição.
# HTTPS; termina normalmente em /neondb/auth. Não é DATABASE_URL.
NEON_AUTH_BASE_URL=
# Origem exata HTTPS (sem caminho/barra final), obrigatória em Production.
# Preview/Development também reconhecem VERCEL_URL/VERCEL_BRANCH_URL.
AUTH_APP_ORIGIN=
# Habilita o login EXISTENTE, recuperação e verificação sem liberar dados financeiros.
# VITE_FINANCIAL_REMOTE_ENABLED=true continua habilitando esse mesmo login no Preview.
VITE_AUTH_ENABLED=false
# Flags públicas de dados: false mantém o comportamento IndexedDB se Auth também estiver false.
VITE_FINANCIAL_REMOTE_ENABLED=false
VITE_ALLOW_LOCAL_FALLBACK=false
# UUID público da organização do escopo atual. Nunca concede acesso por si só.
# Production não tem fallback para o UUID de desenvolvimento; preencher com UUID confirmado.
# O build usa VERCEL_ENV da plataforma para distinguir Production de Preview/Development.
VITE_FINANCIAL_WORKSPACE_ID=
